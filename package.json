{
	"name": "intendencia-scout",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"auth:schema": "auth generate --config src/lib/server/auth.ts --output src/lib/server/db/auth.schema.ts --yes",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/roboto": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@libsql/client": "^0.17.3",
		"@lucide/svelte": "^1.70.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"auth": "^1.6.24",
		"better-auth": "^1.6.24",
		"bits-ui": "^2.20.0",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"shadcn-svelte": "^1.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwind-variants": "^3.3.0",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"mode-watcher": "^1.1.0",
		"zod": "^4.6.7"
	}
}
